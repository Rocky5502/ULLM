# Credentials and local environments
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.venv/
venv/

# Python caches and test state
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Third-party benchmark bytes are fetched locally and must not be redistributed here.
data/imperfectiveNLI.json
data/MANIFEST.local.json
data/dataset_manifest.json

# API/model outputs can be large and may contain provider-returned text.
results/raw/**
results/processed/**
results/figures/**
!results/raw/.gitkeep
!results/processed/.gitkeep
!results/figures/.gitkeep
!results/README.md

# Local rehearsal, provenance, and environment snapshots.
artifacts/local/**

# Local manuscript/build/archive artifacts are outside this code repository.
